# VaayuGuard's OWN Supabase project — separate from vaayutrip-crm's project.
# Do not point these at the CRM's production database.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never expose to the browser. Used solely by /api/agent/* to
# read/write on behalf of enrolled devices, which authenticate with their
# own opaque device tokens (never a Supabase key).
SUPABASE_SERVICE_ROLE_KEY=
