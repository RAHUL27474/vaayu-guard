<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The Worker SDK defaults to a console app, which pops a visible
         (closable!) black window on every launch — closing it via its own
         X kills the process instantly, no Task Manager needed. Confirmed
         live: this is very likely what's been making the agent/watchdog
         vanish throughout today's testing. WinExe runs with no console at
         all, silently in the background, with no window for anyone to
         close. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>VaayuMonitor.Agent</RootNamespace>
    <AssemblyName>VaayuGuardAgent</AssemblyName>

    <!-- Pilot deployment: one self-contained exe, no .NET runtime required
         on target PCs. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <PackageReference Include="System.Management" Version="9.0.9" />
  </ItemGroup>
</Project>
